# --- секреты и локальное окружение -------------------------------------------
# .env.example — единственный файл окружения, который попадает в репозиторий.
.env
.env.*
!.env.example
*.pem
*.key

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- виртуальные окружения ----------------------------------------------------
.venv/
venv/
env/

# --- кэши инструментов --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- локальные данные ---------------------------------------------------------
# sqlite локального запуска; в проде Postgres на Railway
data/
*.db
*.sqlite
*.sqlite3
*.log

# --- рабочие файлы базы знаний ------------------------------------------------
# Резервные копии снимаются перед каждой правкой из CRM и админки: их место —
# рядом с рабочей базой знаний на диске, а не в репозитории.
kb/.backups/
kb/.write.lock

# --- ОС и редакторы -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ВНИМАНИЕ: kb/ и media/ игнорировать НЕЛЬЗЯ — база знаний и фото прайса едут
# в репозитории и раздаются приложением (SCOPE-OVERRIDE §2 п.8).
