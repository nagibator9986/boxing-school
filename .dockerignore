# Что НЕ попадает в образ. Dockerfile копирует корень целиком (COPY . /app),
# поэтому этот файл — единственный фильтр содержимого образа.
#
# ВАЖНО: app/, kb/, media/, migrations/, alembic.ini, requirements.txt и pyproject.toml
# исключать нельзя — без них приложение не стартует.

# --- секреты ------------------------------------------------------------------
.env
.env.*
*.pem
*.key

# --- git и CI -----------------------------------------------------------------
.git
.gitignore
.github
.gitattributes

# --- окружения и кэши ---------------------------------------------------------
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
htmlcov
coverage.xml

# --- то, что нужно только разработчику ----------------------------------------
# scripts/ ИСКЛЮЧАТЬ НЕЛЬЗЯ: из него запускается служба (scripts/serve.py),
# а он поднимает CRM и бота. Без этого каталога контейнер стартует и сразу
# падает с «can't open file scripts/serve.py».
docs
tests
Makefile
docker-compose.yml
README.md
*.md

# --- локальные данные ---------------------------------------------------------
data
# Резервные копии базы знаний живут на диске рядом с ней, в образе они не нужны.
kb/.backups
kb/.write.lock
*.db
*.sqlite
*.sqlite3
*.log
.DS_Store
.idea
.vscode
