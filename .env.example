# =============================================================================
# AINAZAROV TOP TEAM — пример окружения.
#
# Имена переменных = имена полей app/config.py в ВЕРХНЕМ РЕГИСТРЕ. Ничего, кроме
# этого файла и панели Variables в Railway, окружение не задаёт: os.environ по коду
# запрещён, единственный вход — app/config.py.
#
# Локально:  cp .env.example .env  и заполнить секреты.
# На Railway: Variables → RAW Editor → вставить блоки «ЗАДАЁТ ЗАКАЗЧИК» целиком.
#             Блок «ПОДСТАВЛЯЕТ RAILWAY» вбивать руками НЕ нужно.
#
# Секреты (WAZZUP_API_KEY, GEMINI_API_KEY, WAZZUP_WEBHOOK_SECRET, ADMIN_TOKEN)
# оставлены пустыми намеренно. В .env их пишет заказчик, в репозиторий они не попадают.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ПОДСТАВЛЯЕТ RAILWAY — руками не трогать
# -----------------------------------------------------------------------------
# PORT              — порт HTTP-сервера. На Railway инъектируется платформой, приложение
#                     обязано слушать 0.0.0.0:$PORT. Локально можно задать вручную.
# DATABASE_URL      — файл SQLite. На Railway положите его в том: /data/bot.db
#                     Схему postgresql:// (и legacy postgres://) app/config.py сам приводит
#                     к postgresql+asyncpg:// и вырезает sslmode — правки руками не нужны.
# REDIS_URL         — не нужен: TTL-состояние живёт в SQLite (STATE_SQLITE_PATH).
# PUBLIC_BASE_URL   — на Railway это https://${{ RAILWAY_PUBLIC_DOMAIN }} (домен появляется
#                     после Settings → Networking → Generate Domain).
#
# Значения ниже — для локального запуска через docker-compose.
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_URL=
PUBLIC_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# 2. ЗАДАЁТ ЗАКАЗЧИК — окружение и HTTP
# -----------------------------------------------------------------------------
# Режим работы: local | staging | prod. При значении, отличном от local, включаются
# блокеры старта (обязательные ключи, https в PUBLIC_BASE_URL, получатель лид-карточек).
APP_ENV=local

# Порог логирования: DEBUG | INFO | WARNING | ERROR. В проде INFO.
LOG_LEVEL=INFO

# true — одна строка JSON на запись (так Railway разбирает логи на атрибуты).
# false — человекочитаемый вывод, удобно локально.
LOG_JSON=true

# Интерфейс прослушивания. В контейнере всегда 0.0.0.0, иначе edge-прокси Railway не достучится.
HOST=0.0.0.0

# Таймзона контейнера — влияет только на читаемость таймстемпов в логах.
# Расчёты (тихие часы, рабочее время) идут по TIMEZONE из блока 8.
TZ=Asia/Almaty


# -----------------------------------------------------------------------------
# 3. ЗАДАЁТ ЗАКАЗЧИК — Wazzup24 (WhatsApp + Instagram Direct)
# -----------------------------------------------------------------------------
# Ключ API. Личный кабинет Wazzup24 → «Интеграции» → «Интеграция с CRM» → API →
# «Дополнительно» → создать/скопировать ключ. СЕКРЕТ.
WAZZUP_API_KEY=

# База API. Менять не нужно.
WAZZUP_API_BASE=https://api.wazzup24.com/v3

# 32 случайных байта base64url — попадают в путь вебхука /wazzup/webhook/<секрет>,
# по нему запрос и опознаётся. Сгенерировать:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# СЕКРЕТ. При смене нужно заново зарегистрировать вебхук в Wazzup.
WAZZUP_WEBHOOK_SECRET=

# Идентификаторы каналов из GET https://api.wazzup24.com/v3/channels (поле channelId).
# Если канала нет — оставить пустым, бот будет работать с одним каналом.
WAZZUP_CHANNEL_ID_WHATSAPP=
WAZZUP_CHANNEL_ID_INSTAGRAM=

# Всегда false: автоответ бота не должен гасить счётчик неотвеченных у менеджера.
WAZZUP_CLEAR_UNANSWERED=false

# Таймаут HTTP-вызова Wazzup, мс.
WAZZUP_TIMEOUT_MS=15000

# Сколько раз повторять отправку при 429/5xx и база экспоненциального backoff, мс.
WAZZUP_SEND_MAX_ATTEMPTS=5
WAZZUP_SEND_BACKOFF_BASE_MS=1000

# true — приложение само зарегистрирует вебхук на старте (PATCH /v3/webhooks).
# По умолчанию false: первый раз вебхук регистрируется вручную, после Generate Domain.
WAZZUP_REGISTER_WEBHOOK_ON_START=false


# -----------------------------------------------------------------------------
# 4. ЗАДАЁТ ЗАКАЗЧИК — Google Gemini
# -----------------------------------------------------------------------------
# Ключ из Google AI Studio (https://aistudio.google.com/apikey), тариф Tier 1+ (платный).
# На бесплатном тарифе лимиты не выдержат поток вебхуков. СЕКРЕТ.
GEMINI_API_KEY=

# Основная и запасная модели. Фолбэк включается при таймауте/ошибке основной.
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Глубина «размышления»: minimal | low | medium | high. Для диалога о записи хватает minimal —
# это заметно дешевле и быстрее.
GEMINI_THINKING_LEVEL=minimal

# Таймаут вызова модели, мс, и потолок длины ответа в токенах.
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024

# Максимум витков tool-loop за один ход (защита от зацикливания модели).
LLM_MAX_TOOL_LOOPS=5

# Сколько последних реплик диалога уходит в модель.
LLM_HISTORY_TURNS=20

# Суточный предохранитель расходов, USD. При исчерпании бот уходит в паузу и шлёт алерт.
LLM_DAILY_BUDGET_USD=5.0

# Цены за 1M токенов, USD — нужны только для оценки стоимости в логах и метриках.
LLM_PRICE_IN_PER_MTOK=0.30
LLM_PRICE_OUT_PER_MTOK=2.50


# -----------------------------------------------------------------------------
# 5. ЗАДАЁТ ЗАКАЗЧИК — хранилище
# -----------------------------------------------------------------------------
# Размер пула соединений SQLAlchemy и допустимое превышение.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# true — печатать SQL в логи. Только для отладки, в проде false.
DB_ECHO=false

# Где живёт состояние диалогов (дедуп, дебаунс, паузы, локи).
# sqlite — рабочий вариант: файл переживает перезапуск, внешних служб не нужно.
# memory — только тесты: перезапуск снимает паузу бота посреди разговора.
# redis — остался для пути через Wazzup с отдельным воркером.
STATE_BACKEND=sqlite


# -----------------------------------------------------------------------------
# 6. ЗАДАЁТ ЗАКАЗЧИК — воркер
# -----------------------------------------------------------------------------
# Фоновые задачи: отправка в Wazzup, напоминания, проверка каналов.
# true — выполняются внутри веб-службы, Redis не нужен. Это рабочий режим.
# false — понадобится отдельная служба arq и Redis; на одном диске Railway
# это невозможно, поэтому false имеет смысл только при переезде на Postgres.
INLINE_WORKER=true

# Сколько задач воркер выполняет параллельно и потолок времени одной задачи, с.
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_S=120


# -----------------------------------------------------------------------------
# 7. ЗАДАЁТ ЗАКАЗЧИК — база знаний и медиа
# -----------------------------------------------------------------------------
# Каталоги внутри контейнера: /app/kb и /app/media (обе лежат в репозитории).
KB_DIR=kb
MEDIA_DIR=media

# Версия схемы KB — загрузчик откажется грузить файлы другой версии.
KB_SCHEMA_VERSION=1

# true — перечитывать YAML без рестарта. В проде false (перезагрузка идёт через админку).
KB_HOT_RELOAD=false

# Как часто проверять каталог kb/ на правки из CRM и Telegram-админки, секунды.
# Проверка стоит семь вызовов stat, читает файлы только когда они изменились.
# 0 — не проверять вовсе: тогда правки доедут только после перезапуска.
KB_WATCH_INTERVAL_S=5

# Время жизни подписанной ссылки /media/{token}, с. Wazzup должен успеть скачать файл.
MEDIA_TOKEN_TTL_S=600

# Ключ подписи ссылок на медиа. Пустой — берётся WAZZUP_WEBHOOK_SECRET. СЕКРЕТ.
MEDIA_TOKEN_SECRET=


# -----------------------------------------------------------------------------
# 8. ЗАДАЁТ ЗАКАЗЧИК — поведение диалога
# -----------------------------------------------------------------------------
# Таймзона всех расчётов: тихие часы, рабочее время, слоты пробной тренировки.
TIMEZONE=Asia/Almaty

# Дебаунс: сколько ждать «дописывания» клиента и до скольки продлевать ожидание, с.
DEBOUNCE_SECONDS=5
DEBOUNCE_MAX_SECONDS=8

# Время жизни лока диалога, с — чтобы две реплики API не отвечали одновременно.
CONV_LOCK_TTL_SECONDS=60

# Сколько помнить messageId ради дедупликации повторов вебхука, с (сутки).
DEDUP_TTL_SECONDS=86400

# Мягкий предел длины сообщения (после него текст делится) и максимум сообщений подряд.
# Жёсткий предел 1000 знаков зашит в код: это лимит Instagram.
SOFT_MESSAGE_CHARS=600
MAX_MESSAGES_PER_TURN=2

# Пауза между первым и вторым сообщением бота, мс — чтобы не выглядело роботом.
SECOND_MESSAGE_DELAY_MS=2000

# Паузы бота в минутах: после ответа оператора, по просьбе клиента, после эскалации,
# после срабатывания анти-галлюцинационного фильтра, после сбоя модели.
PAUSE_OPERATOR_MINUTES=30
PAUSE_USER_REQUEST_MINUTES=60
PAUSE_ESCALATION_MINUTES=60
PAUSE_POSTCHECK_MINUTES=30
PAUSE_LLM_FAILURE_MINUTES=15

# Служебная строка, которой оператор возвращает диалог боту. Клиенту не пересылается.
OPERATOR_RESUME_COMMAND=#бот

# Сколько промахов бота подряд допустимо до эскалации на менеджера.
BOT_MISS_LIMIT=2

# Антифлуд: сколько входящих от одного диалога допустимо в окне, и длина окна в секундах.
RATE_LIMIT_INBOUND_PER_CONV=20
RATE_LIMIT_WINDOW_SECONDS=300


# -----------------------------------------------------------------------------
# 9. ЗАДАЁТ ЗАКАЗЧИК — follow-up (напоминания)
# -----------------------------------------------------------------------------
# Включены ли напоминания и сколько их максимум на один диалог.
FOLLOWUP_ENABLED=true
FOLLOWUP_MAX_ATTEMPTS=2

# Тихие часы: с 21:00 до 09:00 по TIMEZONE напоминания не отправляются.
FOLLOWUP_QUIET_HOURS_START=21
FOLLOWUP_QUIET_HOURS_END=9


# -----------------------------------------------------------------------------
# 10. ЗАДАЁТ ЗАКАЗЧИК — уведомления менеджеру
# -----------------------------------------------------------------------------
# Куда слать лид-карточки: whatsapp | instagram.
MANAGER_NOTIFY_CHANNEL=whatsapp

# Получатель карточки. Для WhatsApp — только цифры, формат 77xxxxxxxxx (без плюса).
MANAGER_NOTIFY_TARGET=

# Через какой канал Wazzup слать карточку. Пусто — берётся канал из MANAGER_NOTIFY_CHANNEL.
MANAGER_NOTIFY_CHANNEL_ID=

# Рабочие часы школы и обещанный клиенту срок ответа менеджера, мин.
# Это текст обещания в диалоге, а не расписание тренировок (расписание — в KB).
WORK_HOURS=10:00-20:00
SLA_MINUTES=30


# -----------------------------------------------------------------------------
# 11. ЗАДАЁТ ЗАКАЗЧИК — админка и метрики
# -----------------------------------------------------------------------------
# Токен для служебных ручек (/admin/*: перезагрузка KB, снятие паузы). СЕКРЕТ.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Отдавать ли /metrics в формате Prometheus.
METRICS_ENABLED=true

# --- Админка -----------------------------------------------------------
# Пароль входа: кто пришлёт его боту в Telegram, станет администратором.
# Права сохраняются в data/admin.db и переживают перезапуск.
# Пустое значение полностью закрывает вход по паролю.
ADMIN_PASSWORD=Azamat65
# Файлы SQLite: диалоги, TTL-состояние, права и настройки.
STATE_SQLITE_PATH=data/state.db
ADMIN_DB_PATH=data/admin.db

# --- Развёртывание -----------------------------------------------------
# Каталог диска, где живут база знаний, история диалогов, заявки и настройки.
# На Railway — точка подключения тома, обычно /data. Пустое значение означает
# «искать /data, иначе ./data»; заданный и недоступный на запись каталог
# останавливает запуск, чтобы данные не потерялись молча при передеплое.
DATA_DIR=/data
# Что поднимать в контейнере. Обе части живут вместе, потому что делят файлы.
RUN_WEB=true
RUN_BOT=true
# Веб-служба поднимает CRM и приём вебхуков Wazzup на одном порту:
#   /crm              — интерфейс управления
#   /wazzup/webhook/… — приём сообщений WhatsApp и Instagram
#   /healthz          — проверка живости для Railway
# Пока WAZZUP_API_KEY пуст, приём не поднимается, а CRM и Telegram работают.

# --- CRM (scripts/crm.py) ----------------------------------------------
# Вход в CRM — по тому же ADMIN_PASSWORD, второго пароля нет.
CRM_HOST=127.0.0.1
CRM_PORT=8000
# Ключ подписи сессионных куки. Пустой — генерируется при запуске, и тогда
# после перезапуска CRM придётся войти заново. Для постоянного входа задайте:
# python -c "import secrets;print(secrets.token_hex(32))"   СЕКРЕТ.
CRM_SECRET_KEY=
# База диалогов, которую показывает CRM. Пусто — берётся data/telegram.db,
# если она есть, иначе data/bot.db. Задавайте, если бот пишет в другой файл.
CRM_BOT_DB=
